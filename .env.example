# Copy this file to .env and fill in your own values.
# .env is gitignored, so your real values never go into the repo.

# Django
SECRET_KEY=generate-your-own-see-README-or-group-chat
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (your local MySQL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email (console backend prints emails to the terminal while developing)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Community Vision Board <noreply@example.com>
# Google reCAPTCHA v2
# Use Google's public test keys for local development/demo only.
# Replace with real keys before production deployment.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
